  "components": {
    "schemas": {
      "BookingCreateDto": {
        "required": [
          "bookingDate",
          "providerId",
          "serviceId"
        ],
        "type": "object",
        "properties": {
          "serviceId": {
            "type": "integer",
            "format": "int32"
          },
          "providerId": {
            "type": "integer",
            "format": "int32"
          },
          "bookingDate": {
            "type": "string",
            "format": "date-time"
          },
          "bookingTime": {
            "type": "string",
            "format": "date-span",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BookingUpdateDto": {
        "type": "object",
        "properties": {
          "bookingDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "bookingTime": {
            "type": "string",
            "format": "date-span",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PaymentCreateDto": {
        "required": [
          "amount",
          "bookingId",
          "method",
          "userId"
        ],
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "integer",
            "format": "int32"
          },
          "userId": {
            "minLength": 1,
            "type": "string"
          },
          "amount": {
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "method": {
            "$ref": "#/components/schemas/PaymentMethod"
          }
        },
        "additionalProperties": false
      },
      "PaymentMethod": {
        "enum": [
          0,
          1,
          2,
          3,
          4
        ],
        "type": "integer",
        "format": "int32"
      },
      "PaymentUpdateStatusDto": {
        "type": "object",
        "properties": {
          "transactionId": {
            "type": "string",
            "nullable": true
          },
          "rawResponse": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
